# RVC models & cache (large binaries — download separately)
models/*.onnx
models/*.pth
models/*.pt
models/*.index
models/*.npy
# but keep the README
!models/README.txt
!models/*.md

# RVC generated outputs (not source code, can be regenerated)
models/voice_demo_*.wav
models/test_*.wav

# HuBERT cache (regenerable via _download_hubert.py)
models/_hubert_dl/

# Release artifacts
voice-changer-v*-source.zip
